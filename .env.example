# Copy to .env and fill in. .env is gitignored.

# Interactive Brokers (paper) — same account as the magic formula, distinct client id.
IB_HOST=127.0.0.1
IB_PORT=7497          # the paper Gateway's socket port
IB_CLIENT_ID=6        # distinct from magic-formula (5)

# Overlay sizing
BUDGET=100000         # risk budget the overlay is anchored to (× target_vol = overlay $ vol)
OVERLAY_MULT=0.5      # start at 0.5x (~half target vol), scale to 1.0 once comfortable
TARGET_VOL=0.10       # annualized portfolio vol target

# Daily email report (Gmail: use an App Password, not your login password)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_gmail_app_password
TO_EMAIL=where.to.send@example.com
